@using Frontend.Services
@using Frontend.DTOs.Project
@using MudBlazor
@inject ISnackbar _snackbar
@inject ProjectService ProjectService

<MudDialog>
    <DialogContent>
        @if (_editContext is not null)
        {
            <EditForm EditContext="@_editContext">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <MudStack Spacing="2">
                    <MudTextField T="string"
                                  Label="Nome"
                                  Variant="Variant.Outlined"
                                  @bind-Value="Projeto.Nome"
                                  Required="true"
                                  FullWidth="true" />

                    <MudTextField T="string"
                                  Label="Nome do Cliente"
                                  Variant="Variant.Outlined"
                                  @bind-Value="Projeto.NomeCliente"
                                  FullWidth="true" />

                    <MudTextField T="string"
                                  Label="Descrição"
                                  Variant="Variant.Outlined"
                                  @bind-Value="Projeto.Descricao"
                                  TextArea="true"
                                  Lines="3"
                                  FullWidth="true" />

                    <MudNumericField T="decimal?"
                                     Label="Preço/Hora (€)"
                                     Variant="Variant.Outlined"
                                     @bind-Value="Projeto.PrecoHora"
                                     Min="0"
                                     DecimalPlaces="2"
                                     FullWidth="true" />
                </MudStack>
            </EditForm>
        }
        else
        {
            <MudProgressCircular Indeterminate Color="Color.Primary" />
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="@Submit" Disabled="_editContext is null">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int ProjetoId { get; set; }

    private ProjectUpdateDto Projeto { get; set; } = new();
    private EditContext? _editContext;

    protected override async Task OnInitializedAsync()
    {
        var detalhes = await ProjectService.GetByIdAsync(ProjetoId);
        Projeto = new ProjectUpdateDto
        {
            Nome = detalhes.Nome,
            NomeCliente = detalhes.NomeCliente,
            Descricao = detalhes.Descricao,
            PrecoHora = detalhes.PrecoHora,
            Responsavel = detalhes.Responsavel,
            DataCriacao = detalhes.DataCriacao
        };

        _editContext = new EditContext(Projeto);
    }

    private async Task Submit()
    {
        if (_editContext?.Validate() == true)
        {
            try
            {
                await ProjectService.UpdateAsync(ProjetoId, Projeto);
                _snackbar.Add("Projeto atualizado com sucesso.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                _snackbar.Add($"Erro ao atualizar projeto: {ex.Message}", Severity.Error);
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
