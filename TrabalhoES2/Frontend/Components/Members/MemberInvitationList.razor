@using Frontend.DTOs.User
@using Frontend.Services
@using MudBlazor
@inject ISnackbar Snackbar
@inject MemberService MemberService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage


<MudDialog>
    <DialogContent>
        <EditForm EditContext="@editContext">
            <DataAnnotationsValidator />
            <MudStack Spacing="2">
                <MudSelect T="int" @bind-Value="selectedUserId" Label="Selecionar Utilizador" Required="true" FullWidth="true">
                    @if (AvailableUsers.Any())
                    {
                        @foreach (var user in AvailableUsers)
                        {
                            <MudSelectItem T="int" Value="@user.IdUtilizador">@user.Nome (@user.Username)</MudSelectItem>
                        }
                    }
                    else
                    {
                        <MudSelectItem T="int" Disabled="true">Nenhum utilizador disponível</MudSelectItem>
                    }
                </MudSelect>
                <ValidationSummary />
            </MudStack>
        </EditForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="@Submit" Disabled="@(selectedUserId == 0)">Convidar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<UserDetailsDto> AvailableUsers { get; set; } = new();
    [Parameter] public int ProjetoId { get; set; }

    private EditContext editContext = default!;
    private int selectedUserId;

    protected override void OnInitialized()
    {
        editContext = new EditContext(this);
    }

    private async Task Submit()
    {
        try
        {
            var currentUserId = await LocalStorage.GetItemAsync<int>("user_id");
            await MemberService.InviteToProjectAsync(currentUserId, selectedUserId, ProjetoId);
            Snackbar.Add("Convite enviado com sucesso.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao convidar: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
