@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="dashboard-wrapper">
    <!-- Sidebar -->
    <aside class="sidebar @(sidebarOpen ? "open" : "closed")">
        <div class="logo-area">
            <img src="/images/helpmate-logo2.png" alt="Logo" />
            <button class="toggle-close" @onclick="ToggleSidebar">❌</button>
        </div>

        <nav class="nav-buttons">
            <button class="nav-btn" @onclick="@(() => NavigateTo("menu"))">🏠 Painel</button>
            <button class="nav-btn" @onclick="@(() => NavigateTo("projetos/menu"))">📁 Projetos</button>
            <button class="nav-btn" @onclick="@(() => NavigateTo("tarefas/menu"))">📝 Tarefas</button>
            <button class="nav-btn" @onclick="@(() => NavigateTo("conta"))">👤 Conta</button>
        </nav>


        <div class="logout-section">
            <button class="logout-btn" @onclick="Logout">🚪 Sair</button>
        </div>
    </aside>

    <!-- Botão flutuante -->
    @if (!sidebarOpen)
    {
        <button class="floating-toggle" @onclick="ToggleSidebar">➡️</button>
    }

    <!-- Conteúdo principal -->
    <main class="main-content @(sidebarOpen ? "" : "sidebar-closed")">
        <div class="content-wrapper">
            @Body
        </div>
    </main>
</div>

@code {
    private bool sidebarOpen = true;

    void ToggleSidebar() => sidebarOpen = !sidebarOpen;

    void NavigateTo(string page) => Navigation.NavigateTo($"/{page}");

    void Logout() => Navigation.NavigateTo("/login");
}