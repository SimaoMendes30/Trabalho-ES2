@page "/tarefas/definir-preco"
@layout DashboardLayout
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using Frontend.DTO_s

<div class="form-card">
    <h2 class="form-title">💶 Definir Preço da Tarefa</h2>

    @if (!_carregado)
    {
        <p>A carregar dados...</p>
    }
    else if (_tarefasEmProgresso.Count == 0)
    {
        <div class="alert alert-warning">Não existem tarefas em progresso disponíveis.</div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label fw-semibold">Selecionar Tarefa em Progresso:</label>
            <select class="form-select" @onchange="OnTarefaSelecionada">
                <option value="">-- Escolha uma tarefa --</option>
                @foreach (var t in _tarefasEmProgresso)
                {
                    <option value="@t.IdTarefa">@($"{t.IdTarefa} - {t.Descricao}")</option>
                }
            </select>
        </div>

        @if (_idTarefaSelecionada > 0 && _projetos.Count > 0)
        {
            <div class="mb-3">
                <label class="form-label fw-semibold">Selecionar Projeto:</label>
                <select class="form-select" @bind="_idProjetoSelecionado">
                    <option value="">-- Escolha um projeto --</option>
                    @foreach (var p in _projetos)
                    {
                        <option value="@p.IdProjeto">@($"{p.IdProjeto} - {p.Nome}")</option>
                    }
                </select>
            </div>

            <button class="btn btn-primary custom-button mt-2" @onclick="DefinirPrecoHora" disabled="@_definindo">
                @_definindo ? "A aplicar preço..." : "Aplicar Preço Hora do Projeto"
            </button>
        }
        else if (_idTarefaSelecionada > 0)
        {
            <div class="alert alert-warning">Esta tarefa não tem projetos associados disponíveis.</div>
        }

        @if (!string.IsNullOrEmpty(_mensagemErro))
        {
            <div class="alert alert-danger mt-3">@_mensagemErro</div>
        }

        @if (!string.IsNullOrEmpty(_mensagemSucesso))
        {
            <div class="alert alert-success mt-3">@_mensagemSucesso</div>
        }
    }
</div>

@code {
    private List<TarefaDTO> _tarefasEmProgresso = new();
    private List<ProjetoDTO> _projetos = new();
    private int _idTarefaSelecionada;
    private int _idProjetoSelecionado;

    private bool _carregado = false;
    private bool _definindo = false;
    private string _mensagemErro = string.Empty;
    private string _mensagemSucesso = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userIdString = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdString, out int userId))
            {
                _mensagemErro = "Utilizador não autenticado.";
                return;
            }

            var utilizador = await Http.GetFromJsonAsync<UtilizadorDTO>($"api/utilizador/{userId}");

            // Tarefas em progresso
            if (utilizador?.IdTarefas is not null)
            {
                foreach (var id in utilizador.IdTarefas)
                {
                    var tarefa = await Http.GetFromJsonAsync<TarefaDTO>($"api/tarefa/{id}");
                    if (tarefa?.Estado == "Em Progresso")
                        _tarefasEmProgresso.Add(tarefa);
                }
            }

            // Projetos disponíveis
            if (utilizador?.IdProjetos is not null)
            {
                foreach (var id in utilizador.IdProjetos)
                {
                    var projeto = await Http.GetFromJsonAsync<ProjetoDTO>($"api/projeto/{id}");
                    if (projeto != null)
                        _projetos.Add(projeto);
                }
            }

            _carregado = true;
        }
        catch (Exception ex)
        {
            _mensagemErro = $"Erro ao carregar dados: {ex.Message}";
        }
    }

    private Task OnTarefaSelecionada(ChangeEventArgs e)
    {
        _mensagemErro = _mensagemSucesso = string.Empty;

        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            _idTarefaSelecionada = id;
        }

        return Task.CompletedTask;
    }

    private async Task DefinirPrecoHora()
    {
        _mensagemErro = _mensagemSucesso = string.Empty;
        _definindo = true;

        try
        {
            if (_idTarefaSelecionada == 0 || _idProjetoSelecionado == 0)
            {
                _mensagemErro = "Por favor selecione uma tarefa e um projeto.";
                return;
            }

            var response = await Http.PostAsync(
                $"api/tarefa/{_idTarefaSelecionada}/definir-preco-hora?idProjeto={_idProjetoSelecionado}",
                null
            );

            if (response.IsSuccessStatusCode)
            {
                var msg = await response.Content.ReadAsStringAsync();
                _mensagemSucesso = msg;
            }
            else
            {
                _mensagemErro = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            _mensagemErro = $"Erro ao definir preço: {ex.Message}";
        }
        finally
        {
            _definindo = false;
        }
    }
}
