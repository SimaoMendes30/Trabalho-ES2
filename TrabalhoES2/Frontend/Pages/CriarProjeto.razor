@page "/projetos/criar"
@layout DashboardLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using Frontend.DTO_s

<div class="form-card">
    <h2 class="form-title">📁 Criar Projeto</h2>

    <EditForm Model="_projeto" OnValidSubmit="SubmeterProjeto">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <InputText class="form-control custom-input" @bind-Value="_projeto.Nome" placeholder="Nome do Projeto" />
        <InputText class="form-control custom-input" @bind-Value="_projeto.NomeCliente" placeholder="Cliente" />
        <InputText class="form-control custom-input" @bind-Value="_projeto.Descricao" placeholder="Descrição" />
        <InputNumber class="form-control custom-input" @bind-Value="_projeto.PrecoHora" placeholder="Preço por Hora (€)" />

        <button class="btn btn-primary custom-button" type="submit" disabled="@isSubmitting">
            @(isSubmitting ? "A criar..." : "Criar Projeto")
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(_erroMensagem))
    {
        <div class="alert alert-danger mt-3">@_erroMensagem</div>
    }
    @if (!string.IsNullOrEmpty(_mensagemSucesso))
    {
        <div class="alert alert-success mt-3">@_mensagemSucesso</div>
    }
</div>

@code {
    ProjetoDTO _projeto = new();
    string _erroMensagem = string.Empty;
    string _mensagemSucesso = string.Empty;
    bool isSubmitting = false;

    async Task SubmeterProjeto()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        await InvokeAsync(StateHasChanged);

        _erroMensagem = string.Empty;
        _mensagemSucesso = string.Empty;

        try
        {
            var userIdString = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdString, out int userId))
            {
                _erroMensagem = "Utilizador não autenticado. Faça login novamente.";
                return;
            }

            var request = new HttpRequestMessage(HttpMethod.Post, "api/projeto");
            request.Headers.Add("X-User-Id", userId.ToString());
            request.Content = JsonContent.Create(_projeto);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                _mensagemSucesso = "Projeto criado com sucesso!";
                await Task.Delay(800);
                Navigation.NavigateTo("/menu");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _erroMensagem = "Já existe um projeto com este nome para este utilizador.";
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                _erroMensagem = $"Erro ao criar projeto: {erro}";
            }
        }
        catch (Exception ex)
        {
            _erroMensagem = $"Erro inesperado: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
