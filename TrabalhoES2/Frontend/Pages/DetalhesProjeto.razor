@page "/projetos/detalhes"
@layout DashboardLayout
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@using Frontend.DTO_s

<div class="form-card">
    <h2 class="form-title">📄 Detalhes dos Projetos</h2>

    @if (!_carregado)
    {
        <p>A carregar projetos...</p>
    }
    else if (_projetos.Count == 0)
    {
        <div class="alert alert-warning mt-3">Não tem projetos associados.</div>
    }
    else
    {
        <label for="projetoSelect" class="form-label fw-semibold text-start w-100 mb-2">Selecionar Projeto:</label>
        <select id="projetoSelect" class="form-select custom-input mb-4" @onchange="SelecionarProjeto">
            <option value="">-- Escolha um projeto --</option>
            @foreach (var projeto in _projetos)
            {
                <option value="@projeto.IdProjeto">@($"{projeto.IdProjeto} - {projeto.Nome}")</option>
            }
        </select>

        @if (_projetoSelecionado != null)
        {
            <div class="text-start">
                <p><strong>📁 Nome do Projeto:</strong> @_projetoSelecionado.Nome</p>
                <p><strong>👤 Cliente:</strong> @_projetoSelecionado.NomeCliente</p>
                <p><strong>📝 Descrição:</strong> @_projetoSelecionado.Descricao</p>
                <p><strong>💶 Preço por Hora:</strong> @_projetoSelecionado.PrecoHora €</p>
            </div>
        }

        <button class="btn btn-secondary custom-button mt-4" @onclick="VoltarAoMenu">🔙 Voltar ao Menu</button>
    }
</div>

@code {
    List<ProjetoDTO> _projetos = new();
    ProjetoDTO? _projetoSelecionado;
    bool _carregado = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProjetosDoUtilizador();
    }

    async Task CarregarProjetosDoUtilizador()
    {
        try
        {
            var userIdString = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdString, out int userId))
                return;

            var utilizador = await Http.GetFromJsonAsync<UtilizadorDTO>($"api/utilizador/{userId}");
            if (utilizador?.IdProjetos is not null)
            {
                foreach (var id in utilizador.IdProjetos)
                {
                    var projeto = await Http.GetFromJsonAsync<ProjetoDTO>($"api/projeto/{id}");
                    if (projeto != null)
                        _projetos.Add(projeto);
                }
            }
        }
        catch
        {
            // erro silencioso
        }
        finally
        {
            _carregado = true;
        }
    }

    void SelecionarProjeto(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            _projetoSelecionado = _projetos.FirstOrDefault(p => p.IdProjeto == id);
        }
        else
        {
            _projetoSelecionado = null;
        }
    }

    void VoltarAoMenu()
    {
        Navigation.NavigateTo("/menu");
    }
}
