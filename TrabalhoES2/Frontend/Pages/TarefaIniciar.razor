@page "/tarefas/iniciar"
@layout DashboardLayout
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using Frontend.DTO_s

<div class="form-card">
    <h2 class="form-title">▶️ Iniciar Tarefa</h2>

    @if (!_carregado)
    {
        <p>A carregar projetos...</p>
    }
    else if (_projetos.Count == 0)
    {
        <div class="alert alert-warning">Nenhum projeto disponível.</div>
    }
    else
    {
        <EditForm Model="_novaTarefa" OnValidSubmit="IniciarTarefa">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label fw-semibold">Projeto:</label>
                <select class="form-select" @bind="_idProjetoSelecionado" required>
                    <option value="">-- Selecione um projeto --</option>
                    @foreach (var projeto in _projetos)
                    {
                        <option value="@projeto.IdProjeto">@($"{projeto.IdProjeto} - {projeto.Nome}")</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Descrição da Tarefa:</label>
                <InputText class="form-control" @bind-Value="_novaTarefa.Descricao" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Data e Hora de Início:</label>
                <InputDate class="form-control" @bind-Value="_novaTarefa.DataHoraInicio" />
            </div>

            <button type="submit" class="btn btn-primary custom-button mt-2" disabled="@_iniciando">
                @(_iniciando ? "A iniciar..." : "Iniciar Tarefa")
            </button>

        </EditForm>

        @if (!string.IsNullOrEmpty(_mensagemErro))
        {
            <div class="alert alert-danger mt-3">@_mensagemErro</div>
        }

        @if (!string.IsNullOrEmpty(_mensagemSucesso))
        {
            <div class="alert alert-success mt-3">@_mensagemSucesso</div>
        }
    }
</div>

@code {
    private TarefaInicioDTO _novaTarefa = new()
    {
        DataHoraInicio = DateTime.Now.ToUniversalTime()
    };

    private List<ProjetoDTO> _projetos = new();
    private int _idProjetoSelecionado;
    private bool _carregado = false;
    private bool _iniciando = false;

    private string _mensagemErro = string.Empty;
    private string _mensagemSucesso = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userIdString = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdString, out int userId))
            {
                _mensagemErro = "ID de utilizador inválido.";
                return;
            }

            _novaTarefa.Responsavel = userId;

            var utilizador = await Http.GetFromJsonAsync<UtilizadorDTO>($"api/utilizador/{userId}");

            if (utilizador?.IdProjetos != null)
            {
                foreach (var id in utilizador.IdProjetos)
                {
                    var projeto = await Http.GetFromJsonAsync<ProjetoDTO>($"api/projeto/{id}");
                    if (projeto != null)
                        _projetos.Add(projeto);
                }
            }
        }
        catch (Exception ex)
        {
            _mensagemErro = $"Erro ao carregar projetos: {ex.Message}";
        }
        finally
        {
            _carregado = true;
        }
    }

    private async Task IniciarTarefa()
    {
        _iniciando = true;
        _mensagemErro = _mensagemSucesso = string.Empty;

        try
        {
            if (_idProjetoSelecionado == 0)
            {
                _mensagemErro = "Por favor selecione um projeto.";
                return;
            }

            _novaTarefa.IdProjeto = _idProjetoSelecionado; // ✅ incluir projeto
            _novaTarefa.DataHoraInicio = _novaTarefa.DataHoraInicio.ToUniversalTime(); // evitar erro do backend

            var response = await Http.PostAsJsonAsync("api/tarefa/iniciar", _novaTarefa);

            if (response.IsSuccessStatusCode)
            {
                _mensagemSucesso = "Tarefa iniciada com sucesso!";
            }
            else
            {
                _mensagemErro = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            _mensagemErro = $"Erro ao iniciar tarefa: {ex.Message}";
        }
        finally
        {
            _iniciando = false;
        }
    }
}
