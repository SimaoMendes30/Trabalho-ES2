@page "/projetos/editar"
@layout DashboardLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using Frontend.DTO_s

<div class="form-card">
    <h2 class="form-title">✏️ Alterar Projeto</h2>

    @if (!_carregado)
    {
        <p class="text-muted">🔄 A carregar os seus projetos...</p>
    }
    else if (_projetosDoUtilizador.Count == 0)
    {
        <div class="alert alert-warning">Nenhum projeto associado ao seu utilizador.</div>
    }
    else
    {
        <!-- Seleção do Projeto -->
        <p class="text-muted mb-2 fw-bold">Selecionar Projeto:</p>
        <select class="form-select custom-input mb-4" @onchange="SelecionarProjeto">
            <option disabled selected value="">-- Escolha um projeto --</option>
            @foreach (var projeto in _projetosDoUtilizador)
            {
                <option value="@projeto.IdProjeto">@($"{projeto.IdProjeto} - {projeto.Nome}")</option>
            }
        </select>
    }

    <!-- Edição do Projeto -->
    @if (_projetoSelecionado is not null)
    {
        <h5 class="text-muted mb-3 mt-3 fw-bold">Editar Projeto:</h5>
        <EditForm Model="_projetoSelecionado" OnValidSubmit="AtualizarProjeto" @key="_projetoSelecionado.IdProjeto">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <label for="nome" class="form-label fw-semibold text-start w-100">Nome do Projeto:</label>
            <InputText id="nome" class="form-control custom-input mb-2" @bind-Value="_projetoSelecionado.Nome" />

            <label for="cliente" class="form-label fw-semibold text-start w-100">Nome do Cliente:</label>
            <InputText id="cliente" class="form-control custom-input mb-2" @bind-Value="_projetoSelecionado.NomeCliente" />

            <label for="descricao" class="form-label fw-semibold text-start w-100">Descrição:</label>
            <InputText id="descricao" class="form-control custom-input mb-2" @bind-Value="_projetoSelecionado.Descricao" />

            <label for="preco" class="form-label fw-semibold text-start w-100">Preço por Hora (€):</label>
            <InputNumber id="preco" class="form-control custom-input mb-3" @bind-Value="_projetoSelecionado.PrecoHora" />

            <button class="btn btn-primary custom-button mt-2" type="submit" disabled="@isUpdating">
                @(isUpdating ? "A atualizar..." : "Atualizar Projeto")
            </button>
        </EditForm>
    }

    @if (!string.IsNullOrEmpty(_erroMensagem))
    {
        <div class="alert alert-danger mt-3">@_erroMensagem</div>
    }

    @if (!string.IsNullOrEmpty(_mensagemSucesso))
    {
        <div class="alert alert-success mt-3">@_mensagemSucesso</div>
    }
</div>

@code {
    List<ProjetoDTO> _projetosDoUtilizador = new();
    ProjetoDTO? _projetoSelecionado;
    string _erroMensagem = string.Empty;
    string _mensagemSucesso = string.Empty;
    bool isUpdating = false;
    bool _carregado = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProjetosDoUtilizador();
    }

    async Task CarregarProjetosDoUtilizador()
    {
        try
        {
            var userIdString = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdString, out int userId))
            {
                _erroMensagem = "ID do utilizador inválido.";
                return;
            }

            var utilizador = await Http.GetFromJsonAsync<UtilizadorDTO>($"api/utilizador/{userId}");
            if (utilizador?.IdProjetos is null || !utilizador.IdProjetos.Any())
            {
                _carregado = true;
                return;
            }

            foreach (var id in utilizador.IdProjetos)
            {
                var projeto = await Http.GetFromJsonAsync<ProjetoDTO>($"api/projeto/{id}");
                if (projeto != null)
                    _projetosDoUtilizador.Add(projeto);
            }
        }
        catch (Exception ex)
        {
            _erroMensagem = $"Erro ao carregar projetos: {ex.Message}";
        }
        finally
        {
            _carregado = true;
        }
    }

    async Task SelecionarProjeto(ChangeEventArgs e)
    {
        _mensagemSucesso = string.Empty;
        _erroMensagem = string.Empty;

        if (int.TryParse(e.Value?.ToString(), out int projetoId))
        {
            _projetoSelecionado = _projetosDoUtilizador.FirstOrDefault(p => p.IdProjeto == projetoId);
        }
        else
        {
            _projetoSelecionado = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    async Task AtualizarProjeto()
    {
        if (_projetoSelecionado == null)
        {
            _erroMensagem = "Nenhum projeto selecionado.";
            return;
        }

        isUpdating = true;
        _erroMensagem = string.Empty;
        _mensagemSucesso = string.Empty;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/projeto/{_projetoSelecionado.IdProjeto}", _projetoSelecionado);

            if (response.IsSuccessStatusCode)
            {
                _mensagemSucesso = "Projeto atualizado com sucesso!";
                await Task.Delay(800);
                Navigation.NavigateTo("/menu");
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                _erroMensagem = $"Erro ao atualizar projeto: {erro}";
            }
        }
        catch (Exception ex)
        {
            _erroMensagem = $"Erro inesperado: {ex.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }
}
