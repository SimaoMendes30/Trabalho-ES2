@page "/projetos/eliminar"
@layout DashboardLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using Frontend.DTO_s

<div class="form-card">
    <h2 class="form-title">🗑️ Eliminar Projeto</h2>

    @if (!_carregado)
    {
        <p>A carregar projetos...</p>
    }
    else if (_projetos.Count == 0)
    {
        <div class="alert alert-warning mt-3">Não tem projetos para eliminar.</div>
    }
    else
    {
        <label for="projetoSelect" class="form-label fw-semibold text-start w-100 mb-2">Selecionar Projeto:</label>
        <select id="projetoSelect" class="form-select custom-input mb-4" @onchange="SelecionarProjeto">
            <option value="">-- Escolha um projeto --</option>
            @foreach (var projeto in _projetos)
            {
                <option value="@projeto.IdProjeto">@($"{projeto.IdProjeto} - {projeto.Nome}")</option>
            }
        </select>

        @if (_idProjetoSelecionado > 0)
        {
            <button class="btn btn-danger custom-button w-100" @onclick="SubmeterEliminacao" disabled="@isDeleting">
                @(isDeleting ? "A eliminar..." : "Eliminar Projeto")
            </button>
        }

        @if (!string.IsNullOrEmpty(_mensagem))
        {
            <div class="alert alert-info mt-3">@_mensagem</div>
        }
    }
</div>

@code {
    List<ProjetoDTO> _projetos = new();
    int _idProjetoSelecionado;
    bool _carregado = false;
    string _mensagem = string.Empty;
    bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProjetos();
    }

    async Task CarregarProjetos()
    {
        try
        {
            var userIdString = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!int.TryParse(userIdString, out int userId))
            {
                _mensagem = "Utilizador não autenticado.";
                return;
            }

            var utilizador = await Http.GetFromJsonAsync<UtilizadorDTO>($"api/utilizador/{userId}");
            if (utilizador?.IdProjetos is not null)
            {
                foreach (var id in utilizador.IdProjetos)
                {
                    var projeto = await Http.GetFromJsonAsync<ProjetoDTO>($"api/projeto/{id}");
                    if (projeto != null) _projetos.Add(projeto);
                }
            }
        }
        catch (Exception ex)
        {
            _mensagem = $"Erro ao carregar projetos: {ex.Message}";
        }
        finally
        {
            _carregado = true;
        }
    }

    void SelecionarProjeto(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out _idProjetoSelecionado);
        _mensagem = string.Empty;
    }

    async Task SubmeterEliminacao()
    {
        isDeleting = true;
        _mensagem = string.Empty;

        try
        {
            await Http.DeleteAsync($"api/projeto/{_idProjetoSelecionado}");
            _mensagem = "✅ Projeto eliminado com sucesso.";
            await Task.Delay(1000);
            Navigation.NavigateTo("/menu", forceLoad: true);
        }
        catch (Exception ex)
        {
            _mensagem = $"Erro ao eliminar projeto: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
        }
    }
}
