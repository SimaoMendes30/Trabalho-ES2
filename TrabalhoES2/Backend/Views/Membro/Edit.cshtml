@model Backend.Models.Membro

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit</title>
</head>
<body>

<h4>Membro</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdMembro" />
            <div class="form-group">
                <label asp-for="IdUtilizador" class="control-label"></label>
                <select asp-for="IdUtilizador" class="form-control" asp-items="ViewBag.IdUtilizador"></select>
                <span asp-validation-for="IdUtilizador" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IdProjeto" class="control-label"></label>
                <select asp-for="IdProjeto" class="form-control" asp-items="ViewBag.IdProjeto"></select>
                <span asp-validation-for="IdProjeto" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataConvite" class="control-label"></label>
                <input asp-for="DataConvite" class="form-control" />
                <span asp-validation-for="DataConvite" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataEstado" class="control-label"></label>
                <input asp-for="DataEstado" class="form-control" />
                <span asp-validation-for="DataEstado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EstadoConvite" class="control-label"></label>
                <input asp-for="EstadoConvite" class="form-control" />
                <span asp-validation-for="EstadoConvite" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EstadoAtividade" class="control-label"></label>
                <input asp-for="EstadoAtividade" class="form-control" />
                <span asp-validation-for="EstadoAtividade" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

</body>
</html>
