@model IEnumerable<Backend.Models.Membro>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DataConvite)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataEstado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoConvite)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoAtividade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Projeto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Utilizador)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DataConvite)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataEstado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoConvite)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoAtividade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Projeto.IdProjeto)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Utilizador.IdUtilizador)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdMembro">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdMembro">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdMembro">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</body>
</html>
